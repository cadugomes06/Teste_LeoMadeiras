{
  "ConnectionStrings": {
    "ApiFoundation": "Data Source=apifoundation.db"
  },
  "LeomobFake": {
    "TaxaFalha": 0
  },
  "ReprocessamentoAutomatico": {
    "Habilitado": true,
    "IntervaloSegundos": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "AllowedHosts": "*"
}
